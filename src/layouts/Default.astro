---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { slide } from "astro:transitions";
---

<!doctype html>
<html lang="en" class={`antialiased`}>
  <head>
    <link
      rel="preload"
      href="/Font.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css?family=JetBrains%20Mono"
      rel="stylesheet"
    />
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body
    class="flex no-scrollbar flex-col h-full bg-gray-100 mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 pt-8 pb-16"
  >
    <Header title={SITE_TITLE} />
    <main transition:animate={slide({ duration: "0.2s" })}>
      <slot />
    </main>
  </body>
</html>
