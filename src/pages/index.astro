---
import Default from "@/layouts/Default.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";
const posts = await getCollection("blog", (entry) => !entry.data.draft);
---

<Default>
  <section>
    <ul
      class="flex flex-col divide-y border-y divide-neutral-100 border-neutral-100"
    >
      {
        posts.map((post) => (
          <ul class="py-2.5 group">
            <a href={`/blog/${post.slug}`} class="flex items-center space-x-4">
              <div class="text-neutral-400 font-medium text-sm">
                <time datetime={post.data.created.toISOString()}>
                  {format(post.data.created, "MMM yyyy")}
                </time>
              </div>
              <p
                class="group-hover:underline flex-1 line-clamp-1 underline-offset-4"
                transition:name={`blog-${post.data.title}`}
              >
                {post.data.title}
              </p>
            </a>
          </ul>
        ))
      }
    </ul>
  </section>
</Default>
