---
import Default from "@/layouts/Default.astro";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import { fade, slide } from "astro:transitions";

const posts = (await getCollection("notes")).filter(
    (note) => !note.data.private,
);
---

<Default>
    <section>
        <ul
            class="flex flex-col divide-y border-y divide-neutral-100 border-neutral-100"
        >
            {
                posts.map((note) => (
                    <ul class="py-2.5 group">
                        <a
                            href={`/notes/${note.slug}`}
                            class="flex items-center space-x-4"
                        >
                            <p class="text-neutral-400 font-medium text-sm">
                                <time
                                    datetime={note.data.created.toISOString()}
                                >
                                    {note.data.created.toLocaleDateString(
                                        "en-us",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </time>
                            </p>
                            <p
                                class="group-hover:underline"
                                transition:name={`note-${note.data.title}`}
                            >
                                {note.data.title}
                            </p>
                        </a>
                    </ul>
                ))
            }
        </ul>
    </section>
</Default>
